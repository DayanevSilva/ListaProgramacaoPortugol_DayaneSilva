programa
{
	funcao inicio()
	{
		cadeia senha

		faca
		{
			escreva("Digite a senha: ")
			leia(senha)

			se (senha != "12345")
			{
				escreva("Senha incorreta!\n")
			}
		}
		enquanto (senha != "12345")

		escreva("Senha correta! Acesso permitido.\n")
	}
}

